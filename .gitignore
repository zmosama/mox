# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Local application state. The server owns its own database; committing any of
# these can expose accounts, sessions, ratings, or legacy credentials.
/data/
/backup/
/legacy/

# This install's own deploy target — host, paths, port. The code is shared; a
# particular server is not.
/deploy/target.env

# Engineering continuity log. Working notes about this specific deployment.
/HANDOFF.md

# Local assistant/editor state
/.claude/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
