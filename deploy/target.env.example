# Where `deploy/deploy.sh` sends this install. Copy to `deploy/target.env` and
# fill in your own values — that file is ignored by Git, so nobody's server
# details ship with the code.
#
#   cp deploy/target.env.example deploy/target.env

# SSH host (an entry in your ~/.ssh/config, or user@hostname).
MOX_HOST=my-server

# Absolute path on that host. The database lives in `$MOX_DEST/data` and is
# never overwritten by a deploy.
MOX_DEST=/Users/you/projects/mox

# Port the app listens on there.
MOX_PORT=8782

# Reverse-DNS prefix for the LaunchAgents (`<prefix>.app`).
MOX_LABEL=com.example.mox

# Optional: LaunchAgent labels this install used to run under, space separated.
# They are unloaded and removed before the current ones are loaded.
# MOX_RETIRED_LABELS="com.example.mox-old"
