<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>__LABEL__</string>
  <!-- Brings the feeds, calendar, service catalogue and universes up to date.
       Deliberately NOT KeepAlive: this is a job that finishes, and launchd
       would restart it in a loop forever. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>export PATH=$HOME/.local/bin:/opt/homebrew/bin:$PATH; cd __DEST__ &amp;&amp; exec npm run refresh</string>
  </array>
  <key>WorkingDirectory</key><string>__DEST__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key><string>production</string>
  </dict>
  <!-- Local time on the server: after TMDB's own daily churn, and long before
       anybody opens the site. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>__FEEDS_HOUR__</integer>
    <key>Minute</key><integer>__FEEDS_MINUTE__</integer>
  </dict>
  <!-- Also on load, so a deploy leaves the site current instead of waiting
       until the next morning to catch up. -->
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__DEST__/data/refresh.log</string>
  <key>StandardErrorPath</key><string>__DEST__/data/refresh.err.log</string>
</dict>
</plist>
